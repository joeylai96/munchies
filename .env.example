# Public — safe to expose to the browser (Supabase's anon key is designed for this;
# your database is protected by Row Level Security, not by hiding this key).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public — USDA's key just identifies your app for rate-limiting, it's not a secret.
VITE_USDA_API_KEY=your-usda-key

# SECRET — only ever set these in the Netlify dashboard (Site settings > Environment
# variables), never commit them or prefix with VITE_. They're used only inside
# netlify/functions, which run on Netlify's servers, never in the browser.
# Google AI Studio's free tier needs no billing/credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-free-gemini-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
